{
  "expo": {
    "name": "kamnex",
    "slug": "kamnex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/images/logo/logo-kamnex.png",
    "scheme": "kamnexevent",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "androidNavigationBar": {
      "visible": "immersive"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.huyanhbui.kamnexevent",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần truy cập camera để chụp ảnh và quét mã QR.",
        "NSMicrophoneUsageDescription": "Ứng dụng cần sử dụng micro để ghi âm khi quay video.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần quyền truy cập thư viện ảnh để bạn chọn và tải ảnh lên.",
        "NSLocationWhenInUseUsageDescription": "Ứng dụng cần truy cập vị trí để hiển thị bản đồ và gợi ý địa điểm.",
        "NSUserTrackingUsageDescription": "Cho phép ứng dụng theo dõi hoạt động của bạn để cải thiện trải nghiệm người dùng."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDc5gJqICVzNvMKQrs7UEgRBpVF89le6lo"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "assets/images/logo/logo-kamnex.png",
        "backgroundImage": "assets/images/logo/logo-kamnex.png",
        "monochromeImage": "assets/images/logo/logo-kamnex.png"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDc5gJqICVzNvMKQrs7UEgRBpVF89le6lo"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "package": "com.huyanhbui.kamnexevent"
    },
    "web": {
      "output": "static",
      "favicon": "assets/images/logo/logo-kamnex.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "assets/images/logo/logo-kamnex.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96b588ff-c82a-48fb-9bc2-2e124f5583de"
      }
    },
    "owner": "nhmsoftbujhuyanh"
  }
}
